<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The app previously inherited these via manifest merging from the AWS
         SDK's library manifest; with that dependency removed (issue #310) they
         must be declared here, or every network call (Retrofit, Coil, the
         presigned-URL upload) dies with a SecurityException. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Runtime-requested on Android 13+ (API 33) for push (issues #342/#343). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:name=".PositiveOnlySocialApp"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PositiveOnlySocial">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PositiveOnlySocial">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links for shared post links (issue #382). autoVerify makes
                 Android check https://smiling.social/.well-known/assetlinks.json
                 for this package + signing certificate at install time; only
                 then does the link open the app instead of the browser. Both
                 hosts serve the same site, so a link shared with the www.
                 prefix opens the app too.

                 Scoped to /post/ rather than the whole site on purpose: every
                 other route (login, profiles, the privacy policy) belongs to
                 the website, and claiming them would hijack links the app has
                 no screen for. MainActivity parses the URL and routes it
                 through the same navigator a tapped push notification uses, so
                 a link opened while signed out waits for login instead of
                 dropping the user on an authenticated screen. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" android:host="smiling.social" android:pathPrefix="/post/" />
                <data android:scheme="https" android:host="www.smiling.social" android:pathPrefix="/post/" />
            </intent-filter>
        </activity>

        <!-- Receives FCM push (issues #342/#343). onNewToken re-registers the
             device; onMessageReceived surfaces a foreground notification. -->
        <service
            android:name=".fcm.PosFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>