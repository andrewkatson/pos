<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links for shared post links (issue #382). Both hosts serve
	     the same site, so a link shared with the www. prefix opens the app too.
	     Requires https://smiling.social/.well-known/apple-app-site-association
	     to list this app id — see website/public/.well-known/. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:smiling.social</string>
		<string>applinks:www.smiling.social</string>
	</array>
</dict>
</plist>
